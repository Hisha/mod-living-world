# Living World
# Shared world-event framework. Individual gameplay systems can be enabled independently.

LivingWorld.Enable = 1
LivingWorld.Playerbots.Enable = 0
LivingWorld.Debug = 1

# Optional gameplay subsystems.
LivingWorld.Invasions.Enable = 1
LivingWorld.Travelers.Enable = 1

# Scheduler timing settings. Development defaults are intentionally short for observation/testing.
LivingWorld.Scheduler.Enable = 1
LivingWorld.Scheduler.CheckIntervalSeconds = 5
LivingWorld.Scheduler.InitialDelayMinSeconds = 20
LivingWorld.Scheduler.InitialDelayMaxSeconds = 40
LivingWorld.Scheduler.NextDelayMinSeconds = 30
LivingWorld.Scheduler.NextDelayMaxSeconds = 60

# A value of 0 means unlimited.
LivingWorld.Scheduler.MaxActiveGlobal = 3
LivingWorld.Scheduler.DefaultMaxActivePerMap = 2
LivingWorld.Scheduler.DefaultMaxActivePerResponseOrigin = 1

# Dynamic overrides support any standard or custom map/response-origin ID.
LivingWorld.Scheduler.MaxActive.Map.0 = 2
LivingWorld.Scheduler.MaxActive.ResponseOrigin.1 = 1
LivingWorld.Scheduler.MaxActive.ResponseOrigin.2 = 1

#
# Traveling world event daily travel window.
# Uses the worldserver machine's local clock.
# StartHour is inclusive; EndHour is exclusive.
#
LivingWorld.Travel.StartHour = 6
LivingWorld.Travel.EndHour = 18
# ---------------------------------------------------------------------------
# Hunts / Prey
# ---------------------------------------------------------------------------
LivingWorld.Hunts.Enable = 1
LivingWorld.Hunts.MinimumLevel = 10

# Geographic range used when a Huntmaster chooses level-appropriate hunting grounds.
# 0 = Local Region: only zones explicitly mapped to that Huntmaster.
# 1 = Continent: anywhere on the Huntmaster's logical continent.
# 2 = World: any enabled level-appropriate hunt zone.
# Local regions are data-driven in 906_hunt_local_regions.sql and may overlap.
LivingWorld.Hunts.SearchScope = 0

# Multiplier applied to the eventual level-appropriate Hunt completion XP.
# The reward code is intentionally deferred while the encounter loop is tested,
# but the balance control is established now rather than hard-coded later.
# 0.0 = no Hunt completion XP, 0.75 = 75%, 1.0 = full baseline, 1.5 = 150%.
LivingWorld.Hunts.XPMultiplier = 0.75